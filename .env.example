# Main instance (automa branch)
DOMAIN=example.com
POSTGRES_USER=terraforming
POSTGRES_PASSWORD=changeme
POSTGRES_DB=terraforming
SERVER_ID=changeme

# Tournament instance (tournament branch)
TOURNAMENT_DOMAIN=tournament.example.com
TOURNAMENT_POSTGRES_USER=terraforming
TOURNAMENT_POSTGRES_PASSWORD=changeme
TOURNAMENT_POSTGRES_DB=terraforming
TOURNAMENT_SERVER_ID=changeme

# Unfinished games are purged this many days after creation (default 10;
# the official server uses 7).
#MAX_GAME_DAYS=10
#TOURNAMENT_MAX_GAME_DAYS=10

# In-memory game cache tuning. The compose default sweeps the cache but keeps
# idle solo games resident for 14 days (336h; the game only supports h/m/s).
#GAME_CACHE=sweep=auto;idle_age=336h
#TOURNAMENT_GAME_CACHE=sweep=auto;idle_age=336h

# housie (family task board)
HOUSIE_DOMAIN=housie.example.com
HOUSIE_PASSWORD=changeme
# at least 32 chars — generate with: openssl rand -hex 32
HOUSIE_SESSION_SECRET=changeme-changeme-changeme-changeme
#HOUSIE_USERS=Kotek,Kocinka
#HOUSIE_TIMEZONE=Europe/Warsaw

# arena (pokebot's Platinum bot on a Gen 5 OU Showdown server). The domain default is
# the production host itself, so nothing here is required for pokemon.zerko.it.
#ARENA_DOMAIN=pokemon.zerko.it
#ARENA_BOT_NAME=Platinum
# comma-separated Showdown names to accept challenges from; empty means anyone
#ARENA_CHALLENGERS=

# Source checkout locations, relative to this directory (see update.sh).
#MAIN_CHECKOUT=../terraforming-mars
#TOURNAMENT_CHECKOUT=../terraforming-mars-tournament
#HOUSIE_CHECKOUT=../housie
#POKEBOT_CHECKOUT=../pokebot
