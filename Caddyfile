(tmsite) {
    handle_errors {
        @502 expression {err.status_code} == 502
        handle @502 {
            root * /srv
            try_files {path} /502.html
            file_server
        }
    }
}

{$DOMAIN} {
    import tmsite
    # The offline Android app (android-build.sh), not linked from anywhere and
    # behind basic auth: APK_USER / APK_PASSWORD_HASH in .env (README). The
    # default hash belongs to a random password nobody kept, so the folder stays
    # shut until .env sets one. Both defaults also live in the compose caddy env:
    # set but empty, the hash would stop Caddy from starting at all.
    redir /android /android/
    handle_path /android/* {
        basic_auth {
            {$APK_USER:android} {$APK_PASSWORD_HASH:JDJhJDE0JGNkUEJQR0Y3Q3E3UVNlRG5kMTB5eS5aRElFOHlYYkpDNzFQSVpibjJOODc3ZXI3TTRDbk9t}
        }
        root * /srv/android
        @apk path *.apk
        header @apk Content-Type application/vnd.android.package-archive
        file_server browse
    }
    handle {
        reverse_proxy app:8080
    }
}

{$TOURNAMENT_DOMAIN} {
    import tmsite
    reverse_proxy app-tournament:8080
}

# the :upstream.localhost fallback matters for the same reason as housie's below
{$UPSTREAM_DOMAIN:upstream.localhost} {
    import tmsite
    reverse_proxy app-upstream:8080
}

# same fallback reasoning as upstream's above
{$UNDO_DOMAIN:undo.localhost} {
    import tmsite
    reverse_proxy app-undo:8080
}

(housiesite) {
    handle_errors {
        @502 expression {err.status_code} == 502
        handle @502 {
            root * /srv
            rewrite * /housie-502.html
            file_server
        }
    }
}

# the :housie.localhost fallback matters — see the compose caddy env comment
{$HOUSIE_DOMAIN:housie.localhost} {
    import housiesite
    request_body {
        max_size 30MB
    }
    reverse_proxy housie:8080 {
        # replace any client-supplied X-Forwarded-For with the real peer, so
        # housie's login throttle can't be bypassed by a spoofed header
        # (the app also defensively reads the LAST hop). Caddy is the only
        # ingress, so there is no legitimate upstream XFF to preserve.
        header_up X-Forwarded-For {remote_host}
    }
}

# M5.1: the Showdown server behind the hosted client. Caddy proxies the WebSocket
# upgrade without configuration. The :pokemon.zerko.it fallback IS the production
# domain (owner's call, 2026-09-12: the name is public through DNS anyway, so
# nothing in .env is needed for this vhost); the fallback form matters for the same
# set-but-empty reason as HOUSIE_DOMAIN -- see the compose caddy env comment.
{$ARENA_DOMAIN:pokemon.zerko.it} {
    reverse_proxy showdown:8000
}
