(tmsite) {
    handle_errors {
        @502 expression {err.status_code} == 502
        handle @502 {
            root * /srv
            try_files {path} /502.html
            file_server
        }
    }
}

{$DOMAIN} {
    import tmsite
    reverse_proxy app:8080
}

{$TOURNAMENT_DOMAIN} {
    import tmsite
    reverse_proxy app-tournament:8080
}

(housiesite) {
    handle_errors {
        @502 expression {err.status_code} == 502
        handle @502 {
            root * /srv
            rewrite * /housie-502.html
            file_server
        }
    }
}

# the :housie.localhost fallback matters — see the compose caddy env comment
{$HOUSIE_DOMAIN:housie.localhost} {
    import housiesite
    request_body {
        max_size 30MB
    }
    reverse_proxy housie:8080 {
        # replace any client-supplied X-Forwarded-For with the real peer, so
        # housie's login throttle can't be bypassed by a spoofed header
        # (the app also defensively reads the LAST hop). Caddy is the only
        # ingress, so there is no legitimate upstream XFF to preserve.
        header_up X-Forwarded-For {remote_host}
    }
}

# M5.2: the Showdown server behind the hosted client. Caddy proxies the WebSocket
# upgrade without configuration. The :arena.localhost fallback matters for the same
# set-but-empty reason as HOUSIE_DOMAIN -- see the compose caddy env comment.
{$ARENA_DOMAIN:arena.localhost} {
    reverse_proxy showdown:8000
}
